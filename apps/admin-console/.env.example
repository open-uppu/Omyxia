# Admin Console — environment configuration
# Copy to .env.local for local dev.

# ============================================================================
# AUTH
# ============================================================================

# HS256 secret used to sign admin-session JWTs. Production MUST be a
# 32+ byte random secret shared with the backend (apps/api). The same
# secret is used to verify tokens issued by /api/admin/auth/login.
ADMIN_JWT_SECRET=dev-only-secret-change-me-please-32bytes-min

# When true, the frontend will mint its own dev-only JWT for the
# hard-coded bootstrap admin (admin@omyxia.app / admin) so the shell can
# be exercised end-to-end without a backend. MUST be false in production.
ADMIN_DEV_MODE=true

# Issuer / audience claims — these are checked on every JWT verification.
ADMIN_JWT_ISSUER=omyxia-admin
ADMIN_JWT_AUDIENCE=admin.omyxia.app

# ============================================================================
# API
# ============================================================================

# Optional: URL to the backend admin endpoints. When set, /api/admin/* is
# proxied via Next.js rewrites. Leave empty for local dev (shell only).
ADMIN_API_URL=